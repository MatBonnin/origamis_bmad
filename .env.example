# Root-level examples. Copy per app if needed.

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/origami

# API (NestJS)
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=24h
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PREMIUM_PRICE_ID=price_xxx
FRONTEND_URL=http://localhost:3000
SESSION_VIDEO_PROVIDER=livekit
SESSION_TRANSCRIPT_PROVIDER=faster-whisper
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=lkapi_xxx
LIVEKIT_API_SECRET=lksec_xxx
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=origami-transcripts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
TRANSCRIPT_QUEUE_NAME=transcript_jobs
TRANSCRIPT_WORKER_SECRET=change_me


# Web (Next.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_in_production
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional
REDIS_URL=redis://localhost:6379
TRANSCRIPT_API_BASE_URL=http://localhost:4000
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
