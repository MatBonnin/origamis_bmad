// Prisma schema for Orig'AMI
// Convention: snake_case for tables and columns

generator client {
  provider = "prisma-client-js"
}

model domain_refs {
  id       String @id @default(uuid())
  slug     String @unique
  label    String
  category String

  @@index([category])
  @@map("domain_refs")
}

model skill_refs {
  id          String  @id @default(uuid())
  slug        String  @unique
  label       String
  domain_slug String?

  @@index([domain_slug])
  @@map("skill_refs")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            String       @id @default(uuid())
  email         String       @unique
  password_hash String
  first_name    String
  last_name     String
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  // Password reset fields
  password_reset_token_hash String?
  password_reset_expires_at DateTime?
  password_reset_used_at    DateTime?

  // Profile fields
  level      String?   // User's level (e.g., "debutant", "intermediaire", "avance")
  objectives String[]  // List of objectives
  bio        String?   // Short bio (max 500 chars)
  avatar_url String?   // URL to avatar image

  user_roles user_roles[]
  sessions   sessions[]
  notification_preferences notification_preferences[]
  notifications notifications[]
  onboarding onboarding?
  profile_suggestion profile_suggestions?
  user_needs user_needs?
  consents   consents[]
  mentor_profile mentor_profiles?
  mentor_interactions_as_student mentor_interactions[] @relation("mentor_interactions_student")
  recommendation_cache recommendation_cache[]
  user_intents user_intents?
  conversations_as_student conversations[] @relation("conversations_student")
  conversations_as_mentor conversations[] @relation("conversations_mentor")
  sent_messages messages[] @relation("messages_sender")
  received_messages messages[] @relation("messages_receiver")
  read_statuses read_status[]
  bookings_as_student bookings[] @relation("bookings_student")
  bookings_as_mentor bookings[] @relation("bookings_mentor")
  mentor_reviews mentor_reviews[] @relation("mentor_reviews_student")
  mentor_review_flags mentor_review_flags[] @relation("mentor_review_flags_reporter")
  mentor_validation_checks mentor_validation_checks[] @relation("mentor_validation_checks_checker")
  mentor_visibility_updates mentor_visibility[] @relation("mentor_visibility_updated_by")
  mentor_visibility_history_updates mentor_visibility_history[] @relation("mentor_visibility_history_updated_by")
  verified_mentor_documents mentor_documents[] @relation("mentor_documents_verified_by")
  mentor_calendar_connections mentor_calendar_connections[]
  mentor_requests_as_student mentor_requests[] @relation("mentor_requests_student")
  program_templates program_templates[]
  student_programs_as_student student_programs[] @relation("student_programs_student")
  student_programs_as_mentor student_programs[] @relation("student_programs_mentor")
  program_documents program_documents[]
  user_audit_logs_as_target user_audit_logs[] @relation("user_audit_logs_user")
  user_audit_logs_as_actor user_audit_logs[] @relation("user_audit_logs_admin")
  incidents_reported incidents[] @relation("incidents_reported_by")
  incident_logs incident_logs[] @relation("incident_logs_performed_by")
  deletion_requests deletion_requests[]
  deletion_actions deletion_actions[] @relation("deletion_actions_admin")
  audit_reports audit_reports[] @relation("audit_reports_requested_by")
  subscription subscriptions?
  session_notes session_notes[] @relation("session_notes_author")
  session_chat_messages session_chat_messages[] @relation("session_chat_messages_author")
  session_documents session_documents[] @relation("session_documents_uploader")
  session_events session_events[] @relation("session_events_actor")

  @@map("users")
}

model onboarding {
  id          String   @id @default(uuid())
  user_id     String   @unique
  step        Int      @default(1)
  answers_json Json    @default("{}")
  completed_at DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("onboarding")
}

enum notification_channel {
  email
  push
  in_app
}

enum notification_category {
  messages
  rdv
  system
}

model notification_preferences {
  id       String                @id @default(uuid())
  user_id  String
  channel  notification_channel
  category notification_category
  enabled  Boolean               @default(true)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, channel, category])
  @@index([user_id])
  @@map("notification_preferences")
}

enum notification_status {
  pending
  sent
  failed
}

model notifications {
  id         String                @id @default(uuid())
  user_id    String
  category   notification_category
  channel    notification_channel
  title      String
  message    String
  payload    Json                  @default("{}")
  status     notification_status   @default(pending)
  retries    Int                   @default(0)
  sent_at    DateTime?
  read_at    DateTime?
  created_at DateTime              @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@index([status])
  @@map("notifications")
}

model roles {
  id   String @id @default(uuid())
  name String @unique // etudiant, mentor, admin, support

  user_roles user_roles[]

  @@map("roles")
}

model user_roles {
  id      String @id @default(uuid())
  user_id String
  role_id String

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model sessions {
  id            String   @id @default(uuid())
  user_id       String
  token         String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())
  last_used_at  DateTime @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model consents {
  id               String    @id @default(uuid())
  user_id          String
  consent_version  String    @default("1.0")
  consented_at     DateTime  @default(now())
  withdrawn_at     DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("consents")
}

model user_needs {
  id             String   @id @default(uuid())
  user_id        String   @unique
  needs_json     Json     @default("{}")
  needs_updated  Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_needs")
}

model profile_suggestions {
  id              String    @id @default(uuid())
  user_id         String    @unique
  suggestion_json Json
  accepted_at     DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("profile_suggestions")
}

model mentor_profiles {
  id              String   @id @default(uuid())
  user_id         String   @unique
  domain          String
  banner_url      String?
  about           String?
  education_level String?
  degrees         String[] @default([])
  keywords        String[] @default([])
  professional_links String[] @default([])
  expertise_tags  String[]
  supported_levels String[]
  support_types   mentor_support_type[] @default([])
  hourly_rate     Int?
  rating_avg      Float?   @default(0)
  is_publish_ready Boolean @default(false)
  is_validated    Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user         users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  availability mentor_availability?
  interactions mentor_interactions[] @relation("mentor_interactions_mentor")
  reviews mentor_reviews[] @relation("mentor_reviews_mentor")
  rating mentor_ratings?
  validation_checks mentor_validation_checks[]
  documents mentor_documents[]
  calendar_busy_slots mentor_calendar_busy_slots[]
  requests mentor_requests[] @relation("mentor_requests_mentor")
  visibility mentor_visibility?
  visibility_history mentor_visibility_history[]

  @@index([domain])
  @@index([is_validated])
  @@index([is_publish_ready])
  @@map("mentor_profiles")
}

model mentor_availability {
  id                String   @id @default(uuid())
  mentor_user_id    String   @unique
  is_available      Boolean  @default(false)
  next_available_at DateTime?
  timezone          String   @default("Europe/Paris")

  // Session settings
  session_duration      Int     @default(60)     // Duration in minutes: 30, 45, 60, 90, 120
  buffer_before         Int     @default(0)      // Buffer before session in minutes: 0-60
  buffer_after          Int     @default(0)      // Buffer after session in minutes: 0-60

  // Scheduling rules
  min_notice_hours      Int     @default(1)      // Minimum hours before booking: 1-168
  max_days_ahead        Int     @default(60)     // Max days in advance to book: 7-365
  start_time_increment  Int     @default(30)     // Start time intervals: 15, 30, 60

  // Limits
  daily_limit           Int?                     // Max sessions per day (null = unlimited)
  weekly_limit          Int?                     // Max sessions per week (null = unlimited)

  updated_at        DateTime @updatedAt

  mentor mentor_profiles          @relation(fields: [mentor_user_id], references: [user_id], onDelete: Cascade)
  slots  mentor_availability_slots[]
  weekly_schedules mentor_weekly_schedule[]
  date_overrides mentor_date_overrides[]

  @@index([is_available])
  @@map("mentor_availability")
}

model mentor_availability_slots {
  id             String   @id @default(uuid())
  availability_id String
  day_of_week    Int      // 0 = dimanche, 6 = samedi
  start_time     String   // HH:mm UTC
  end_time       String   // HH:mm UTC
  is_recurring   Boolean  @default(true)
  status         String   @default("published") // published, draft, blocked
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  availability mentor_availability @relation(fields: [availability_id], references: [id], onDelete: Cascade)
  bookings     bookings[]

  @@index([availability_id])
  @@map("mentor_availability_slots")
}

// Weekly schedule - defines availability windows per day of week
model mentor_weekly_schedule {
  id              String   @id @default(uuid())
  availability_id String
  day_of_week     Int      // 0 = dimanche, 6 = samedi
  is_available    Boolean  @default(true)  // Is this day open for bookings?
  time_windows    Json     @default("[]")  // Array of {start: "HH:mm", end: "HH:mm"}
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  availability mentor_availability @relation(fields: [availability_id], references: [id], onDelete: Cascade)

  @@unique([availability_id, day_of_week])
  @@index([availability_id])
  @@map("mentor_weekly_schedule")
}

// Date overrides - exceptions to regular weekly schedule
enum date_override_type {
  unavailable    // Completely unavailable this day
  custom_hours   // Available but with different hours
}

model mentor_date_overrides {
  id              String              @id @default(uuid())
  availability_id String
  date            DateTime            @db.Date  // Specific date (YYYY-MM-DD)
  override_type   date_override_type
  time_windows    Json?               // If custom_hours: [{start: "HH:mm", end: "HH:mm"}]
  reason          String?             // Optional reason (e.g., "Vacances", "RDV médical")
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  availability mentor_availability @relation(fields: [availability_id], references: [id], onDelete: Cascade)

  @@unique([availability_id, date])
  @@index([availability_id, date])
  @@map("mentor_date_overrides")
}

enum booking_status {
  pending
  confirmed
  cancelled
  completed
}

model bookings {
  id              String         @id @default(uuid())
  student_id      String
  mentor_id       String
  slot_id         String
  booking_date    DateTime       // The specific date of the booking
  start_time      String         // HH:mm
  end_time        String         // HH:mm
  status          booking_status @default(pending)
  notes           String?
  cancelled_by    String?
  cancellation_reason String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  student users @relation("bookings_student", fields: [student_id], references: [id], onDelete: Cascade)
  mentor  users @relation("bookings_mentor", fields: [mentor_id], references: [id], onDelete: Cascade)
  slot    mentor_availability_slots @relation(fields: [slot_id], references: [id], onDelete: Restrict)
  session booking_sessions?
  call_sessions booking_call_sessions[]
  mentor_review mentor_reviews?
  incidents incidents[]
  payment payments?
  session_notes session_notes[]
  session_feedback session_feedback?
  session_chat_messages session_chat_messages[]
  session_documents session_documents[]
  session_transcripts session_transcripts[]
  session_events session_events[]

  @@index([student_id])
  @@index([mentor_id])
  @@index([slot_id, booking_date])
  @@index([status])
  @@map("bookings")
}

model booking_sessions {
  id                         String                    @id @default(uuid())
  booking_id                 String                    @unique
  session_token              String                    @unique
  session_url                String
  provider                   String                    @default("embedded-video")
  provider_room_id           String?
  provider_join_url          String?
  status                     session_room_status       @default(scheduled)
  started_at                 DateTime?
  ended_at                   DateTime?
  transcript_consent_status  transcript_consent_status @default(pending)
  transcript_status          transcript_job_status     @default(not_requested)
  transcript_capture_status  transcript_capture_status @default(not_started)
  transcript_capture_provider_id String?
  transcript_provider_job_id String?
  transcript_consented_at    DateTime?
  transcript_source_url      String?
  transcript_error_message   String?
  expires_at                 DateTime
  created_at                 DateTime                  @default(now())
  updated_at                 DateTime                  @updatedAt

  booking bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  chat_messages session_chat_messages[]
  documents session_documents[]

  @@index([session_token])
  @@index([provider_room_id])
  @@map("booking_sessions")
}

model booking_call_sessions {
  id                            String                    @id @default(uuid())
  booking_id                    String
  call_token                    String                    @unique
  session_url                   String
  provider                      String                    @default("livekit")
  provider_room_id              String?                   @unique
  provider_join_url             String?
  initiated_by                  String?
  status                        call_session_status       @default(initiated)
  participant_identities_json   Json                      @default("[]")
  started_at                    DateTime?
  ended_at                      DateTime?
  expires_at                    DateTime
  transcript_consent_status     transcript_consent_status @default(pending)
  transcript_status             transcript_job_status     @default(not_requested)
  transcript_capture_status     transcript_capture_status @default(not_started)
  transcript_capture_provider_id String?
  transcript_provider_job_id    String?
  transcript_consented_at       DateTime?
  transcript_source_url         String?
  transcript_error_message      String?
  created_at                    DateTime                  @default(now())
  updated_at                    DateTime                  @updatedAt

  booking    bookings              @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  transcript session_transcripts?
  events     session_events[]

  @@index([booking_id, status])
  @@index([booking_id, created_at])
  @@index([provider_room_id])
  @@map("booking_call_sessions")
}

enum session_room_status {
  scheduled
  waiting
  live
  ended
  cancelled
}

enum transcript_job_status {
  not_requested
  pending_consent
  queued
  processing
  completed
  failed
}

enum transcript_consent_status {
  pending
  accepted
  declined
}

enum transcript_capture_status {
  not_started
  recording
  uploaded
  failed
}

enum call_session_status {
  initiated
  waiting
  live
  ended
  missed
  cancelled
}

enum session_event_type {
  room_created
  participant_joined
  participant_left
  room_started
  room_ended
  transcript_requested
  transcript_completed
  transcript_failed
  webhook_received
  error
}

model session_chat_messages {
  id                 String   @id @default(uuid())
  booking_session_id String
  booking_id         String
  author_id          String
  body               String
  document_id        String?
  created_at         DateTime @default(now())

  session  booking_sessions @relation(fields: [booking_session_id], references: [id], onDelete: Cascade)
  booking  bookings         @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  author   users            @relation("session_chat_messages_author", fields: [author_id], references: [id], onDelete: Cascade)
  document session_documents? @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([booking_id, created_at])
  @@index([booking_session_id, created_at])
  @@map("session_chat_messages")
}

model session_documents {
  id                 String   @id @default(uuid())
  booking_session_id String
  booking_id         String
  uploaded_by        String
  url                String
  original_name      String
  file_name          String
  mime_type          String
  size_bytes         Int
  created_at         DateTime @default(now())

  session booking_sessions @relation(fields: [booking_session_id], references: [id], onDelete: Cascade)
  booking bookings         @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  uploader users           @relation("session_documents_uploader", fields: [uploaded_by], references: [id], onDelete: Cascade)
  messages session_chat_messages[]

  @@index([booking_id, created_at])
  @@map("session_documents")
}

model session_transcripts {
  id                      String                @id @default(uuid())
  booking_call_session_id String                @unique
  booking_id              String
  provider                String
  status                  transcript_job_status @default(queued)
  language                String?
  full_text               String?
  summary_text            String?
  segments_json           Json                  @default("[]")
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt

  session booking_call_sessions @relation(fields: [booking_call_session_id], references: [id], onDelete: Cascade)
  booking bookings              @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id, status])
  @@map("session_transcripts")
}

model session_events {
  id                      String             @id @default(uuid())
  booking_call_session_id String
  booking_id              String
  actor_id                String?
  event_type              session_event_type
  provider_event_id       String?            @unique
  payload                 Json               @default("{}")
  created_at              DateTime           @default(now())

  session booking_call_sessions @relation(fields: [booking_call_session_id], references: [id], onDelete: Cascade)
  booking bookings              @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  actor   users?                @relation("session_events_actor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([booking_id, created_at])
  @@map("session_events")
}

model user_intents {
  id                   String   @id @default(uuid())
  user_id              String   @unique
  preferred_domain     String?
  budget_max           Int?
  preferred_objectives String[]
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_intents")
}

model mentor_interactions {
  id                 String   @id @default(uuid())
  student_user_id    String
  mentor_user_id     String
  interaction_count  Int      @default(0)
  last_interaction_at DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  student users           @relation("mentor_interactions_student", fields: [student_user_id], references: [id], onDelete: Cascade)
  mentor  mentor_profiles @relation("mentor_interactions_mentor", fields: [mentor_user_id], references: [user_id], onDelete: Cascade)

  @@unique([student_user_id, mentor_user_id])
  @@index([student_user_id])
  @@map("mentor_interactions")
}

model recommendation_cache {
  id           String   @id @default(uuid())
  user_id      String
  cache_key    String
  payload_json Json
  expires_at   DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, cache_key])
  @@index([expires_at])
  @@map("recommendation_cache")
}

model conversations {
  id              String   @id @default(uuid())
  mentor_id       String
  student_id      String
  last_message_at DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  mentor    users @relation("conversations_mentor", fields: [mentor_id], references: [id], onDelete: Cascade)
  student   users @relation("conversations_student", fields: [student_id], references: [id], onDelete: Cascade)
  messages  messages[]
  read_statuses read_status[]

  @@unique([mentor_id, student_id])
  @@index([student_id])
  @@index([mentor_id])
  @@index([last_message_at])
  @@map("conversations")
}

model messages {
  id                String   @id @default(uuid())
  conversation_id   String
  sender_id         String
  receiver_id       String
  body              String
  metadata          Json     @default("{}")
  client_message_id String?
  created_at        DateTime @default(now())

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       users         @relation("messages_sender", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver     users         @relation("messages_receiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  read_statuses read_status[] @relation("read_status_last_message")

  @@unique([conversation_id, sender_id, client_message_id])
  @@index([conversation_id, created_at])
  @@index([receiver_id])
  @@map("messages")
}

model read_status {
  id                   String   @id @default(uuid())
  conversation_id      String
  user_id              String
  last_read_message_id String?
  updated_at           DateTime @updatedAt

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  last_read_message messages? @relation("read_status_last_message", fields: [last_read_message_id], references: [id], onDelete: SetNull)

  @@unique([conversation_id, user_id])
  @@index([user_id])
  @@map("read_status")
}

enum mentor_review_status {
  pending
  published
  removed
}

enum mentor_review_flag_status {
  open
  reviewed
  dismissed
}

enum mentor_status {
  pending_review
  validated
  rejected
}

enum mentor_support_type {
  ponctuel
  suivi_regulier
  long_uniquement
}

enum mentor_document_type {
  diploma
  certificate
}

enum verification_status {
  pending
  verified
  rejected
}

enum calendar_provider {
  google
}

enum mentor_request_status {
  pending
  accepted
  rejected
  cancelled
}

enum program_milestone_status {
  planned
  in_progress
  review
  done
  blocked
}

enum program_document_type {
  memory
  brief
  annex
  other
}

enum mentor_visibility_status {
  visible
  hidden
  priority
  experimental
}

model mentor_reviews {
  id         String             @id @default(uuid())
  mentor_id  String
  student_id String
  booking_id String?            @unique
  rating     Float
  body       String
  status     mentor_review_status @default(published)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  mentor  mentor_profiles @relation("mentor_reviews_mentor", fields: [mentor_id], references: [user_id], onDelete: Cascade)
  student users           @relation("mentor_reviews_student", fields: [student_id], references: [id], onDelete: Cascade)
  booking bookings?       @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  flags   mentor_review_flags[]

  @@index([mentor_id, status])
  @@index([student_id])
  @@map("mentor_reviews")
}

model mentor_ratings {
  mentor_id       String   @id
  average_rating  Float    @default(0)
  review_count    Int      @default(0)
  updated_at      DateTime @updatedAt

  mentor mentor_profiles @relation(fields: [mentor_id], references: [user_id], onDelete: Cascade)

  @@map("mentor_ratings")
}

model mentor_review_flags {
  id          String                   @id @default(uuid())
  review_id   String
  reporter_id String
  reason      String
  status      mentor_review_flag_status @default(open)
  created_at  DateTime                 @default(now())
  updated_at  DateTime                 @updatedAt

  review   mentor_reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)
  reporter users          @relation("mentor_review_flags_reporter", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@index([review_id])
  @@index([reporter_id])
  @@map("mentor_review_flags")
}

model mentor_validation_checks {
  id         String       @id @default(uuid())
  mentor_id  String
  status     mentor_status
  checked_by String
  notes      String?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  mentor  mentor_profiles @relation(fields: [mentor_id], references: [user_id], onDelete: Cascade)
  checker users           @relation("mentor_validation_checks_checker", fields: [checked_by], references: [id], onDelete: Cascade)

  @@index([mentor_id, status])
  @@index([checked_by])
  @@map("mentor_validation_checks")
}

model mentor_documents {
  id          String   @id @default(uuid())
  mentor_id   String
  document_type mentor_document_type
  url         String
  verification_status verification_status @default(pending)
  verified_by String?
  verified_at DateTime?
  deleted_at  DateTime?
  uploaded_at DateTime @default(now())

  mentor mentor_profiles @relation(fields: [mentor_id], references: [user_id], onDelete: Cascade)
  verifier users? @relation("mentor_documents_verified_by", fields: [verified_by], references: [id], onDelete: SetNull)

  @@index([mentor_id])
  @@index([verification_status])
  @@map("mentor_documents")
}

model mentor_calendar_connections {
  id                String            @id @default(uuid())
  mentor_id         String
  provider          calendar_provider
  access_token_enc  String
  refresh_token_enc String?
  expires_at        DateTime?
  connected_at      DateTime          @default(now())
  disconnected_at   DateTime?
  last_sync_at      DateTime?

  mentor users @relation(fields: [mentor_id], references: [id], onDelete: Cascade)

  @@unique([mentor_id, provider])
  @@index([provider, disconnected_at])
  @@map("mentor_calendar_connections")
}

model mentor_calendar_busy_slots {
  id                String   @id @default(uuid())
  mentor_id         String
  provider          calendar_provider
  provider_event_id String
  start_at          DateTime
  end_at            DateTime
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  mentor mentor_profiles @relation(fields: [mentor_id], references: [user_id], onDelete: Cascade)

  @@unique([mentor_id, provider, provider_event_id])
  @@index([mentor_id, start_at, end_at])
  @@map("mentor_calendar_busy_slots")
}

model mentor_requests {
  id          String               @id @default(uuid())
  mentor_id   String
  student_id  String
  status      mentor_request_status @default(pending)
  message     String?
  decision_reason String?
  created_at  DateTime             @default(now())
  updated_at  DateTime             @updatedAt

  mentor  mentor_profiles @relation("mentor_requests_mentor", fields: [mentor_id], references: [user_id], onDelete: Cascade)
  student users           @relation("mentor_requests_student", fields: [student_id], references: [id], onDelete: Cascade)

  @@index([mentor_id, status])
  @@index([student_id, status])
  @@map("mentor_requests")
}

model program_templates {
  id          String   @id @default(uuid())
  mentor_id   String
  title       String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  mentor users @relation(fields: [mentor_id], references: [id], onDelete: Cascade)
  milestones program_template_milestones[]
  programs student_programs[]

  @@index([mentor_id, updated_at])
  @@map("program_templates")
}

model program_template_milestones {
  id           String   @id @default(uuid())
  template_id  String
  title        String
  description  String?
  milestone_order Int
  due_days_from_start Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  template program_templates @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, milestone_order])
  @@index([template_id])
  @@map("program_template_milestones")
}

model student_programs {
  id          String   @id @default(uuid())
  template_id String?
  mentor_id   String
  student_id  String
  title       String
  status      String   @default("active")
  start_at    DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  template program_templates? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  mentor users @relation("student_programs_mentor", fields: [mentor_id], references: [id], onDelete: Cascade)
  student users @relation("student_programs_student", fields: [student_id], references: [id], onDelete: Cascade)
  milestones student_program_milestones[]
  documents program_documents[]

  @@index([mentor_id, updated_at])
  @@index([student_id, updated_at])
  @@map("student_programs")
}

model student_program_milestones {
  id          String   @id @default(uuid())
  program_id  String
  title       String
  description String?
  milestone_order Int
  deadline_at DateTime
  status      program_milestone_status @default(planned)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  program student_programs @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@index([program_id, milestone_order])
  @@map("student_program_milestones")
}

model program_documents {
  id          String   @id @default(uuid())
  program_id  String
  uploaded_by String
  document_type program_document_type @default(other)
  file_name   String?
  url         String
  created_at  DateTime @default(now())
  deleted_at  DateTime?

  program student_programs @relation(fields: [program_id], references: [id], onDelete: Cascade)
  uploader users @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)

  @@index([program_id, created_at])
  @@index([uploaded_by, created_at])
  @@map("program_documents")
}

model mentor_visibility {
  id             String                 @id @default(uuid())
  mentor_id      String                 @unique
  status         mentor_visibility_status @default(visible)
  effective_from DateTime?
  notes          String?
  updated_by     String
  updated_at     DateTime               @updatedAt

  mentor  mentor_profiles @relation(fields: [mentor_id], references: [user_id], onDelete: Cascade)
  updater users           @relation("mentor_visibility_updated_by", fields: [updated_by], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("mentor_visibility")
}

model mentor_visibility_history {
  id             String                 @id @default(uuid())
  mentor_id      String
  status         mentor_visibility_status
  effective_from DateTime?
  notes          String?
  updated_by     String
  updated_at     DateTime               @default(now())

  mentor  mentor_profiles @relation(fields: [mentor_id], references: [user_id], onDelete: Cascade)
  updater users           @relation("mentor_visibility_history_updated_by", fields: [updated_by], references: [id], onDelete: Cascade)

  @@index([mentor_id, updated_at])
  @@map("mentor_visibility_history")
}

enum user_status {
  active
  suspended
  deleted
}

enum incident_status {
  open
  in_review
  resolved
  escalated
}

enum deletion_request_status {
  requested
  reviewed
  approved
  rejected
  deleted
}

model user_audit_logs {
  id         String   @id @default(uuid())
  user_id    String
  admin_id   String
  action     String
  details    String
  created_at DateTime @default(now())

  user  users @relation("user_audit_logs_user", fields: [user_id], references: [id], onDelete: Cascade)
  admin users @relation("user_audit_logs_admin", fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([admin_id, created_at])
  @@map("user_audit_logs")
}

model incidents {
  id          String          @id @default(uuid())
  session_id  String
  type        String
  reported_by String
  details     String
  status      incident_status @default(open)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  session     bookings              @relation(fields: [session_id], references: [id], onDelete: Cascade)
  reporter    users                 @relation("incidents_reported_by", fields: [reported_by], references: [id], onDelete: Cascade)
  logs        incident_logs[]
  attachments incident_attachments[]

  @@index([session_id, created_at])
  @@index([status])
  @@map("incidents")
}

model incident_logs {
  id           String   @id @default(uuid())
  incident_id  String
  action       String
  performed_by String
  notes        String?
  created_at   DateTime @default(now())

  incident    incidents @relation(fields: [incident_id], references: [id], onDelete: Cascade)
  performer   users     @relation("incident_logs_performed_by", fields: [performed_by], references: [id], onDelete: Cascade)

  @@index([incident_id, created_at])
  @@map("incident_logs")
}

model incident_attachments {
  id          String   @id @default(uuid())
  incident_id String
  type        String
  url         String
  created_at  DateTime @default(now())

  incident incidents @relation(fields: [incident_id], references: [id], onDelete: Cascade)

  @@index([incident_id])
  @@map("incident_attachments")
}

model analytics_snapshots {
  id           String   @id @default(uuid())
  type         String
  payload_json Json
  created_at   DateTime @default(now())

  @@index([type, created_at])
  @@map("analytics_snapshots")
}

model analytics_reports {
  id           String   @id @default(uuid())
  type         String
  status       String
  generated_at DateTime @default(now())
  payload_json Json?

  audit_reports audit_reports[]

  @@index([type, generated_at])
  @@map("analytics_reports")
}

model audit_reports {
  id            String   @id @default(uuid())
  report_id      String
  requested_by   String
  status         String
  created_at     DateTime @default(now())

  report      analytics_reports @relation(fields: [report_id], references: [id], onDelete: Cascade)
  requester   users             @relation("audit_reports_requested_by", fields: [requested_by], references: [id], onDelete: Cascade)

  @@index([report_id])
  @@index([requested_by, created_at])
  @@map("audit_reports")
}

model deletion_requests {
  id           String                  @id @default(uuid())
  user_id      String                  @unique
  requested_at DateTime                @default(now())
  status       deletion_request_status @default(requested)
  reviewed_by  String?
  reason       String?
  updated_at   DateTime                @updatedAt

  user    users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  actions deletion_actions[]

  @@index([status, requested_at])
  @@map("deletion_requests")
}

model deletion_actions {
  id          String   @id @default(uuid())
  request_id  String
  admin_id    String
  action      String
  details     String?
  timestamp   DateTime @default(now())

  request deletion_requests @relation(fields: [request_id], references: [id], onDelete: Cascade)
  admin   users             @relation("deletion_actions_admin", fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([request_id, timestamp])
  @@index([admin_id, timestamp])
  @@map("deletion_actions")
}

// ─── Paiements & Abonnements ───────────────────────────────────────────────

enum payment_status {
  pending
  succeeded
  failed
  refunded
}

enum subscription_plan {
  free
  premium
}

enum subscription_status {
  active
  canceled
  past_due
  trialing
}

model payments {
  id                     String         @id @default(uuid())
  booking_id             String         @unique
  stripe_payment_intent  String?
  amount_cents           Int
  platform_fee_cents     Int
  mentor_payout_cents    Int
  status                 payment_status @default(pending)
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt

  booking bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model subscriptions {
  id                     String              @id @default(uuid())
  user_id                String              @unique
  stripe_customer_id     String?
  stripe_subscription_id String?
  plan                   subscription_plan   @default(free)
  status                 subscription_status @default(active)
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt

  user     users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  invoices invoices[]

  @@map("subscriptions")
}

model invoices {
  id                String   @id @default(uuid())
  subscription_id   String
  stripe_invoice_id String?
  amount_cents      Int
  invoice_pdf_url   String?
  created_at        DateTime @default(now())

  subscription subscriptions @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id, created_at])
  @@map("invoices")
}

// ─── Notes & Feedback post-session ────────────────────────────────────────

enum note_role {
  student
  mentor
}

model session_notes {
  id         String    @id @default(uuid())
  booking_id String
  author_id  String
  role       note_role
  content    String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  booking bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  author  users    @relation("session_notes_author", fields: [author_id], references: [id], onDelete: Cascade)

  @@unique([booking_id, author_id])
  @@index([booking_id])
  @@map("session_notes")
}

model session_feedback {
  id                  String   @id @default(uuid())
  booking_id          String   @unique
  submitted_by        String
  next_actions        String[]
  objectives_met      Boolean
  linked_milestone_id String?
  notes_for_student   String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  booking bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
  @@map("session_feedback")
}
