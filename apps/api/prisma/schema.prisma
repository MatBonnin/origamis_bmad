// Prisma schema for Orig'AMI
// Convention: snake_case for tables and columns

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            String       @id @default(uuid())
  email         String       @unique
  password_hash String
  first_name    String
  last_name     String
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  // Password reset fields
  password_reset_token_hash String?
  password_reset_expires_at DateTime?
  password_reset_used_at    DateTime?

  // Profile fields
  level      String?   // User's level (e.g., "debutant", "intermediaire", "avance")
  objectives String[]  // List of objectives
  bio        String?   // Short bio (max 500 chars)
  avatar_url String?   // URL to avatar image

  user_roles user_roles[]
  sessions   sessions[]
  notification_preferences notification_preferences[]
  notifications notifications[]
  onboarding onboarding?
  profile_suggestion profile_suggestions?
  user_needs user_needs?
  consents   consents[]
  mentor_profile mentor_profiles?
  mentor_interactions_as_student mentor_interactions[] @relation("mentor_interactions_student")
  recommendation_cache recommendation_cache[]
  user_intents user_intents?
  conversations_as_student conversations[] @relation("conversations_student")
  conversations_as_mentor conversations[] @relation("conversations_mentor")
  sent_messages messages[] @relation("messages_sender")
  received_messages messages[] @relation("messages_receiver")
  read_statuses read_status[]
  bookings_as_student bookings[] @relation("bookings_student")
  bookings_as_mentor bookings[] @relation("bookings_mentor")

  @@map("users")
}

model onboarding {
  id          String   @id @default(uuid())
  user_id     String   @unique
  step        Int      @default(1)
  answers_json Json    @default("{}")
  completed_at DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("onboarding")
}

enum notification_channel {
  email
  push
  in_app
}

enum notification_category {
  messages
  rdv
  system
}

model notification_preferences {
  id       String                @id @default(uuid())
  user_id  String
  channel  notification_channel
  category notification_category
  enabled  Boolean               @default(true)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, channel, category])
  @@index([user_id])
  @@map("notification_preferences")
}

enum notification_status {
  pending
  sent
  failed
}

model notifications {
  id         String                @id @default(uuid())
  user_id    String
  category   notification_category
  channel    notification_channel
  title      String
  message    String
  payload    Json                  @default("{}")
  status     notification_status   @default(pending)
  retries    Int                   @default(0)
  sent_at    DateTime?
  read_at    DateTime?
  created_at DateTime              @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@index([status])
  @@map("notifications")
}

model roles {
  id   String @id @default(uuid())
  name String @unique // etudiant, mentor, admin, support

  user_roles user_roles[]

  @@map("roles")
}

model user_roles {
  id      String @id @default(uuid())
  user_id String
  role_id String

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model sessions {
  id            String   @id @default(uuid())
  user_id       String
  token         String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())
  last_used_at  DateTime @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model consents {
  id               String    @id @default(uuid())
  user_id          String
  consent_version  String    @default("1.0")
  consented_at     DateTime  @default(now())
  withdrawn_at     DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("consents")
}

model user_needs {
  id             String   @id @default(uuid())
  user_id        String   @unique
  needs_json     Json     @default("{}")
  needs_updated  Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_needs")
}

model profile_suggestions {
  id              String    @id @default(uuid())
  user_id         String    @unique
  suggestion_json Json
  accepted_at     DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("profile_suggestions")
}

model mentor_profiles {
  id              String   @id @default(uuid())
  user_id         String   @unique
  domain          String
  expertise_tags  String[]
  supported_levels String[]
  hourly_rate     Int?
  rating_avg      Float?   @default(0)
  is_validated    Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user         users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  availability mentor_availability?
  interactions mentor_interactions[] @relation("mentor_interactions_mentor")

  @@index([domain])
  @@index([is_validated])
  @@map("mentor_profiles")
}

model mentor_availability {
  id                String   @id @default(uuid())
  mentor_user_id    String   @unique
  is_available      Boolean  @default(false)
  next_available_at DateTime?
  timezone          String   @default("Europe/Paris")
  updated_at        DateTime @updatedAt

  mentor mentor_profiles          @relation(fields: [mentor_user_id], references: [user_id], onDelete: Cascade)
  slots  mentor_availability_slots[]

  @@index([is_available])
  @@map("mentor_availability")
}

model mentor_availability_slots {
  id             String   @id @default(uuid())
  availability_id String
  day_of_week    Int      // 0 = dimanche, 6 = samedi
  start_time     String   // HH:mm UTC
  end_time       String   // HH:mm UTC
  is_recurring   Boolean  @default(true)
  status         String   @default("published") // published, draft, blocked
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  availability mentor_availability @relation(fields: [availability_id], references: [id], onDelete: Cascade)
  bookings     bookings[]

  @@index([availability_id])
  @@map("mentor_availability_slots")
}

enum booking_status {
  pending
  confirmed
  cancelled
  completed
}

model bookings {
  id              String         @id @default(uuid())
  student_id      String
  mentor_id       String
  slot_id         String
  booking_date    DateTime       // The specific date of the booking
  start_time      String         // HH:mm
  end_time        String         // HH:mm
  status          booking_status @default(pending)
  notes           String?
  cancelled_by    String?
  cancellation_reason String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  student users @relation("bookings_student", fields: [student_id], references: [id], onDelete: Cascade)
  mentor  users @relation("bookings_mentor", fields: [mentor_id], references: [id], onDelete: Cascade)
  slot    mentor_availability_slots @relation(fields: [slot_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([mentor_id])
  @@index([slot_id, booking_date])
  @@index([status])
  @@map("bookings")
}

model user_intents {
  id                   String   @id @default(uuid())
  user_id              String   @unique
  preferred_domain     String?
  budget_max           Int?
  preferred_objectives String[]
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_intents")
}

model mentor_interactions {
  id                 String   @id @default(uuid())
  student_user_id    String
  mentor_user_id     String
  interaction_count  Int      @default(0)
  last_interaction_at DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  student users           @relation("mentor_interactions_student", fields: [student_user_id], references: [id], onDelete: Cascade)
  mentor  mentor_profiles @relation("mentor_interactions_mentor", fields: [mentor_user_id], references: [user_id], onDelete: Cascade)

  @@unique([student_user_id, mentor_user_id])
  @@index([student_user_id])
  @@map("mentor_interactions")
}

model recommendation_cache {
  id           String   @id @default(uuid())
  user_id      String
  cache_key    String
  payload_json Json
  expires_at   DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, cache_key])
  @@index([expires_at])
  @@map("recommendation_cache")
}

model conversations {
  id              String   @id @default(uuid())
  mentor_id       String
  student_id      String
  last_message_at DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  mentor    users @relation("conversations_mentor", fields: [mentor_id], references: [id], onDelete: Cascade)
  student   users @relation("conversations_student", fields: [student_id], references: [id], onDelete: Cascade)
  messages  messages[]
  read_statuses read_status[]

  @@unique([mentor_id, student_id])
  @@index([student_id])
  @@index([mentor_id])
  @@index([last_message_at])
  @@map("conversations")
}

model messages {
  id                String   @id @default(uuid())
  conversation_id   String
  sender_id         String
  receiver_id       String
  body              String
  metadata          Json     @default("{}")
  client_message_id String?
  created_at        DateTime @default(now())

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       users         @relation("messages_sender", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver     users         @relation("messages_receiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  read_statuses read_status[] @relation("read_status_last_message")

  @@unique([conversation_id, sender_id, client_message_id])
  @@index([conversation_id, created_at])
  @@index([receiver_id])
  @@map("messages")
}

model read_status {
  id                   String   @id @default(uuid())
  conversation_id      String
  user_id              String
  last_read_message_id String?
  updated_at           DateTime @updatedAt

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  last_read_message messages? @relation("read_status_last_message", fields: [last_read_message_id], references: [id], onDelete: SetNull)

  @@unique([conversation_id, user_id])
  @@index([user_id])
  @@map("read_status")
}
